<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>MigrationTests.Playwright</RootNamespace>
    <AssemblyName>MigrationTests.Harness</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared\ModuleSetUpFixture.cs is linked into each test project, never compiled here -->
    <Compile Remove="Shared\**" />
    <None Include="Shared\**" />
    <InternalsVisibleTo Include="MigrationTests.Harness.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <!-- PDF engine: PDFsharp + MigraDoc (MIT). Stay on 6.2.x: later 6.x/7.x releases changed license terms. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Direct pin: PDFsharp 6.2.4 pulls Pkcs 8.0.1, which has advisories GHSA-2fmv-rv2c-59x7 / GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
