<Project Sdk="Microsoft.NET.Sdk">
  <!-- Browser-free unit tests (MigrationTests.Reporting) + LoginSetupTest (preflight login). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MigrationTests.Reporting</RootNamespace>
    <AssemblyName>MigrationTests.Harness.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.52.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Harness\MigrationTests.Harness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Harness\Shared\ModuleSetUpFixture.cs" Link="ModuleSetUpFixture.cs" />
    <Content Include="..\appsettings.test.json" Link="appsettings.test.json" CopyToOutputDirectory="Always" />
    <Content Include="..\suppressions.json" Link="suppressions.json" Condition="Exists('..\suppressions.json')" CopyToOutputDirectory="Always" />
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\profiles\*.json" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
