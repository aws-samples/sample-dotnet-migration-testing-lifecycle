<Project Sdk="Microsoft.NET.Sdk">
  <!-- Report + chat-render engine used by lifecycle.ps1 (report / render actions). Browser-free. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>MigrationTests.Reports</RootNamespace>
    <AssemblyName>MigrationTests.Reports</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Harness\MigrationTests.Harness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stack profiles (read via HarnessPaths.Resolve("profiles"); copied for the bin-folder fallback). -->
    <Content Include="..\profiles\*.json" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
