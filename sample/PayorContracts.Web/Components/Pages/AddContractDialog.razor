@using PayorContracts.Web.Models
@using PayorContracts.Web.Services
@inject ContractHierarchyService HierarchyService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="model.Name" Label="Contract Name" Required="true" RequiredError="Name is required (min 3 chars)"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect @bind-Value="model.ContractType" Label="Contract Type" Variant="Variant.Outlined" Class="mb-3" Required="true">
            <MudSelectItem Value="@("Commercial")">Commercial</MudSelectItem>
            <MudSelectItem Value="@("Government")">Government</MudSelectItem>
            <MudSelectItem Value="@("Medicare")">Medicare</MudSelectItem>
            <MudSelectItem Value="@("Medicaid")">Medicaid</MudSelectItem>
        </MudSelect>
        <MudDatePicker @bind-Date="model.StartDate" Label="Start Date" Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Class="mb-3" />
        <MudDatePicker @bind-Date="model.EndDate" Label="End Date" Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Class="mb-3" />
        <MudSwitch @bind-Value="model.IsActive" Label="Active" Color="Color.Success" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private ContractDto model = new() { IsActive = true, ContractType = "Commercial" };
    private string errorMessage = string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(model.Name) || model.Name.Length < 3)
        { errorMessage = "Contract Name is required (min 3 characters)."; return; }

        if (model.StartDate.HasValue && model.EndDate.HasValue && model.StartDate >= model.EndDate)
        { errorMessage = "Start Date must be before End Date."; return; }

        var response = HierarchyService.SaveContract(model);
        if (response.Success)
            MudDialog.Close(DialogResult.Ok(response.Id));
        else
            errorMessage = response.Message;
    }
}
