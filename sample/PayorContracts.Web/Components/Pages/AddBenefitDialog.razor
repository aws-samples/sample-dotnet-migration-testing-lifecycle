@using PayorContracts.Web.Models
@using PayorContracts.Web.Services
@inject ContractHierarchyService HierarchyService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="model.BenefitName" Label="Benefit Name" Required="true" RequiredError="Benefit Name is required (min 3 chars)"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect @bind-Value="model.CoverageType" Label="Coverage Type" Variant="Variant.Outlined" Class="mb-3" Required="true">
            <MudSelectItem Value="@("Medical")">Medical</MudSelectItem>
            <MudSelectItem Value="@("Dental")">Dental</MudSelectItem>
            <MudSelectItem Value="@("Vision")">Vision</MudSelectItem>
            <MudSelectItem Value="@("Pharmacy")">Pharmacy</MudSelectItem>
            <MudSelectItem Value="@("Behavioral")">Behavioral</MudSelectItem>
        </MudSelect>
        <MudNumericField @bind-Value="model.CopayAmount" Label="Copay Amount ($)" Variant="Variant.Outlined" Class="mb-3" Min="0m" />
        <MudDatePicker @bind-Date="model.StartDate" Label="Start Date" Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Class="mb-3" />
        <MudDatePicker @bind-Date="model.EndDate" Label="End Date" Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Class="mb-3" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int PlanId { get; set; }

    private BenefitDto model = new() { CoverageType = "Medical" };
    private string errorMessage = string.Empty;

    protected override void OnInitialized() { model.PlanId = PlanId; }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(model.BenefitName) || model.BenefitName.Length < 3)
        { errorMessage = "Benefit Name is required (min 3 characters)."; return; }

        if (model.CopayAmount < 0)
        { errorMessage = "Copay Amount must be >= 0."; return; }

        if (model.StartDate.HasValue && model.EndDate.HasValue && model.StartDate >= model.EndDate)
        { errorMessage = "Start Date must be before End Date."; return; }

        var response = HierarchyService.SaveBenefit(model);
        if (response.Success)
            MudDialog.Close(DialogResult.Ok(response.Id));
        else
            errorMessage = response.Message;
    }
}
