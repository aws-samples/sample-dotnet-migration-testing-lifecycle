{
  "CoreWcf": {
    "Binding": {
      "Security": {
        "Mode": "None",
        "ClientCredentialType": "None"
      }
    },
    "ServiceBehavior": {
      "IncludeExceptionDetailInFaults": true
    },
    "MessageLogging": {
      "_comment": "Logs full SOAP envelopes, including contact details in the payload. Enable only for local debugging against non-real data.",
      "Enabled": false,
      "LogLevel": "Debug"
    }
  },
  "ConnectionStrings": {
    "PayorContractsDatabase": "Server=localhost;Database=PayorContracts_Dev;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "CoreWCF": "Debug"
    }
  }
}
