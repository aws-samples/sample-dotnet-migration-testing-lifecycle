{
  "CoreWcf": {
    "ServiceBehavior": {
      "IncludeExceptionDetailInFaults": false,
      "HttpGetEnabled": false
    },
    "MessageLogging": {
      "Enabled": false,
      "LogLevel": "Error"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "CoreWCF": "Error",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
